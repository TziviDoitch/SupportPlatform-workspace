{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supportplatform.local/contracts/query-definition.schema.json",
  "title": "QueryDefinition",
  "description": "Canonical query object for SupportPlatform. Structural rules only. Registry membership (field ids must be in filter_field_registry), reversed-range checks, and tenant existence are runtime validation (FluentValidation, S2) and are intentionally out of scope here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "filters"],
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "filters": {
      "type": "object",
      "description": "Keys are canonical field ids from filter_field_registry.",
      "additionalProperties": {
        "oneOf": [
          {
            "title": "code list",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          {
            "title": "year range",
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "from", "to"],
            "properties": {
              "type": { "const": "range" },
              "from": { "type": "integer" },
              "to": { "type": "integer" }
            }
          },
          {
            "title": "single year",
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "const": "single" },
              "value": { "type": "integer" }
            }
          }
        ]
      }
    },
    "segmentation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "metrics": {
      "type": "array",
      "items": { "enum": ["count", "sumAmountApproved"] }
    },
    "paging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageSize", "pageNumber"],
      "properties": {
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "pageNumber": { "type": "integer", "minimum": 1 }
      }
    },
    "sort": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "direction"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["asc", "desc"] }
        }
      }
    }
  }
}
